    "cookie-parser": "1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "10.6.2",
    "jose": "6.1.3",
    "lucide-react": "^0.546.0",
    "minio": "8.0.6",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
