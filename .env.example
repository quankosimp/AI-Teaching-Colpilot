# Local-only sample credentials. Never use these outside a private developer machine.
APP_MODE=local_mock
NODE_ENV=development
PORT=3100
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://copilot:copilot_local_only@127.0.0.1:55432/copilot
JWT_SECRET=local-only-change-before-any-shared-use-0123456789
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=59000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=copilotlocal
MINIO_SECRET_KEY=copilot_local_only
MINIO_BUCKET=copilot-private
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# ENABLE_AI=false
# GEMINI_MODEL=
# GEMINI_API_KEY=
# ZOOM_SDK_KEY=
# ZOOM_SDK_SECRET=
# Disposable integration database and bucket, used only with APP_MODE=test.
TEST_DATABASE_URL=postgresql://copilot:copilot_local_only@127.0.0.1:55432/copilot_test
MINIO_TEST_BUCKET=copilot-private-test
