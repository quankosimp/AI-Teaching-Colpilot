# ==============================================================================
# Teaching Copilot — Local Docker Environment Configuration
# Safe local fixtures ONLY. No sensitive or production credentials.
# ==============================================================================

# Application Execution Mode (local_mock allows mock OAuth, local storage, no live external APIs)
APP_MODE=local_mock
NODE_ENV=development

# Internal API port (used inside docker network)
PORT=3100

# Public Gateway HTTP Origin (strict 127.0.0.1:4170 to match Caddy & CSRF origin guard)
APP_ORIGIN=http://127.0.0.1:4170
GATEWAY_PORT=4170

# PostgreSQL Configuration (isolated port 55433 to avoid collision with dev 55432 and user qatth 5433)
DB_PORT=55433
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_local_only
POSTGRES_DB=copilot
DATABASE_URL=postgresql://copilot:copilot_local_only@postgres:5432/copilot

# MinIO Object Storage (isolated host port 59002 to avoid collision with dev 59000 and user qatth 9000)
MINIO_BROWSER_PORT=59002
MINIO_CONSOLE_PORT=59003
MINIO_ROOT_USER=copilotlocal
MINIO_ROOT_PASSWORD=copilot_local_only
MINIO_BUCKET=copilot-private
MINIO_API_CORS_ALLOW_ORIGIN=http://127.0.0.1:4170,http://localhost:4170

# MinIO Internal Network Endpoint (used by API container inside docker network)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=copilotlocal
MINIO_SECRET_KEY=copilot_local_only

# MinIO Public Signer Config (Used for browser direct PUT/GET presigned URLs)
MINIO_PUBLIC_ENDPOINT=127.0.0.1
MINIO_PUBLIC_PORT=59002
MINIO_PUBLIC_USE_SSL=false

# Container Bind Host (Used inside container to listen on internal bridge interface)
BIND_HOST=0.0.0.0

# Local-only JWT signing key (Min 32 characters; local fixture ONLY)
JWT_SECRET=local-only-change-before-any-shared-use-0123456789

# Automation Flags for Container Startup
AUTO_MIGRATE=true
AUTO_SEED=true

# External Provider Configurations (Omitted in local mock mode; documented for production staging)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# ENABLE_AI=false
# GEMINI_MODEL=
# GEMINI_API_KEY=
# ZOOM_SDK_KEY=
# ZOOM_SDK_SECRET=
