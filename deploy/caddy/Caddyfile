# ==============================================================================
# Caddy Gateway — Local Development & Mock Packaging
# Binds to HTTP on port 4170 (accessible via 127.0.0.1:4170)
# ==============================================================================

:4170 {
    # Serve static assets from built Vite SPA
    root * /srv
    encode zstd gzip

    # Reverse proxy backend API endpoints
    handle /api/* {
        reverse_proxy api:3100 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Reverse proxy health check endpoints
    handle /health/* {
        reverse_proxy api:3100
    }

    # Reverse proxy WebSocket connections (Socket.IO for live classroom)
    handle /socket.io/* {
        reverse_proxy api:3100
    }

    # Single Page Application (SPA) client-side routing fallback
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}
